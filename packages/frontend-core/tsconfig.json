{
  "extends": "../../tsconfig.build.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "..",
    "skipLibCheck": true,
    "allowJs": true,
    "paths": {
      "@budibase/*": ["../*/src"],
      "@/*": ["../bbui/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
