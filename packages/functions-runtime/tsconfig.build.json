{
  "extends": "../../tsconfig.build.json",
  "compilerOptions": {
    "rootDir": "src/",
    "outDir": "dist",
    "target": "es2022",
    "lib": ["es2022"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "**/*.spec.ts",
    "**/*.spec.js",
    "**/*.test.ts",
    "**/*.test.js",
    "__mocks__",
    "src/tests"
  ]
}
